pipeline {
    agent any

    stages {

        stage('Python Version') {
            steps {
                bat 'python --version'
            }
        }

        stage('Run Application') {
            steps {
                bat 'python app.py --test'
            }
        }

        stage('Build') {
            steps {
                echo 'Build Successful'
            }
        }
    }

    post {
        success {
            echo 'Build Successful'
        }

        failure {
            echo 'Build Failed'
        }
    }
}